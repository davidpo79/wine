# Copy to .env for local dev. In Railway, set these in the dashboard. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vinho
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Stripe: cards + Apple Pay / Google Pay (saved card = one-click upsell). Webhook: /api/webhooks/stripe with
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, charge.refunded
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# ifthenpay (payments). Each method is shown only when its key is set. See docs/IFTHENPAY.md.
IFTHENPAY_SANDBOX=1              # 1 = sandbox endpoints (Multibanco, card); remove for live
IFTHENPAY_MBWAY_KEY=             # MB WAY key (no sandbox: ask ifthenpay for a test key)
IFTHENPAY_MB_KEY=                # Multibanco dynamic references key
IFTHENPAY_CCARD_KEY=             # card key (also signs the card return)
IFTHENPAY_GATEWAY_KEY=           # optional: Pay by Link key, needed for Apple Pay / Google Pay
IFTHENPAY_APPLE_KEY=
IFTHENPAY_GOOGLE_KEY=
IFTHENPAY_BACKOFFICE_KEY=        # 0000-0000-0000-0000: refunds, reconciliation, callback activation
IFTHENPAY_ANTI_PHISHING_KEY=     # random 32+ chars, also registered at ifthenpay with the callback URLs
IFTHENPAY_MB_EXPIRY_DAYS=3
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
EMAIL_PROVIDER=                  # telnyx = Telnyx Email API (uses TELNYX_API_KEY); empty = Resend
RESEND_API_KEY=
EMAIL_FROM="Wine Portugal <encomendas@wine-portugal.com>"
ADMIN_ALERT_EMAIL=
SESSION_SECRET=change-me-to-a-long-random-string
SITE_URL=http://localhost:3000

# Abandoned-checkout follow-up (see docs/RECOVERY-SETUP.md)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=            # +351... number on Telnyx (SMS + voice)
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=          # Call Control application id
TELNYX_ASSISTANT_ID=           # AI Assistant id (pt-PT)
TELNYX_PUBLIC_KEY=             # webhook signing public key (base64)
WHATSAPP_PROVIDER=             # telnyx = send through Telnyx (uses TELNYX_API_KEY); empty = Meta Cloud API
TELNYX_WHATSAPP_FROM=          # +351... WhatsApp-enabled number on Telnyx
WHATSAPP_TOKEN=                # Meta WhatsApp Cloud API permanent token (only without Telnyx)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_RECOVERY=trilogia_retomar
WHATSAPP_TEMPLATE_LANG=pt_PT
RECOVERY_WORKER=1              # 0 disables the in-process worker
