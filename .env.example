# Copy to .env for local dev. In Railway, set these in the dashboard. Never commit real values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vinho
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=auto
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# Stripe: cards + Apple Pay / Google Pay (saved card = one-click upsell). Webhook: /api/webhooks/stripe with
# payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled, charge.refunded
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# ifthenpay (payments). Each method is shown only when its key is set. See docs/IFTHENPAY.md.
IFTHENPAY_SANDBOX=1              # 1 = sandbox endpoints (Multibanco, card); remove for live
IFTHENPAY_MBWAY_KEY=             # MB WAY key (no sandbox: ask ifthenpay for a test key)
IFTHENPAY_MB_KEY=                # Multibanco dynamic references key
IFTHENPAY_CCARD_KEY=             # card key (also signs the card return)
IFTHENPAY_GATEWAY_KEY=           # optional: Pay by Link key, needed for Apple Pay / Google Pay
IFTHENPAY_APPLE_KEY=
IFTHENPAY_GOOGLE_KEY=
IFTHENPAY_BACKOFFICE_KEY=        # 0000-0000-0000-0000: refunds, reconciliation, callback activation
IFTHENPAY_ANTI_PHISHING_KEY=     # random 32+ chars, also registered at ifthenpay with the callback URLs
IFTHENPAY_MB_EXPIRY_DAYS=3
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=              # G-XXXXXXXXXX (public, appears in the page)
GA4_API_SECRET=                  # Measurement Protocol secret for the server-side purchase (secret)
CLARITY_PROJECT_ID=              # Microsoft Clarity project id (public); recordings load only with statistics consent
EMAIL_PROVIDER=                  # telnyx = Telnyx Email API (uses TELNYX_API_KEY); empty = Resend
RESEND_API_KEY=
EMAIL_FROM="Wine Portugal <encomendas@mail.wine-portugal.com>"   # domain verified in Resend, with receiving on (Admin → Inbox)
EMAIL_REPLY_TO=                  # optional; empty = replies come back to EMAIL_FROM, into Admin → Inbox
RESEND_WEBHOOK_SECRET=           # optional whsec_... of the Resend webhook (event email.received → /api/webhooks/resend)
ADMIN_ALERT_EMAIL=
SESSION_SECRET=change-me-to-a-long-random-string
SITE_URL=http://localhost:3000

# Abandoned-checkout follow-up (see docs/RECOVERY-SETUP.md)
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=            # +351... number on Telnyx (SMS + voice)
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_CONNECTION_ID=          # Call Control application id
TELNYX_ASSISTANT_ID=           # AI Assistant id (pt-PT)
TELNYX_PUBLIC_KEY=             # webhook signing public key (base64)
WHATSAPP_PROVIDER=             # telnyx = send through Telnyx (uses TELNYX_API_KEY); empty = Meta Cloud API
TELNYX_WHATSAPP_FROM=          # +351... WhatsApp-enabled number on Telnyx
WHATSAPP_TOKEN=                # Meta WhatsApp Cloud API permanent token (only without Telnyx)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_RECOVERY=trilogia_retomar
WHATSAPP_TEMPLATE_LANG=pt_PT
RECOVERY_WORKER=1              # 0 disables the in-process worker

# CTT e-commerce API v3 (labels, tracking, shipped/delivered automatically). The application key (X-APPID) is
# issued by the CTT salesperson; public/secret keys come from enviosecommerce.ctt.pt → Settings → Integrations.
CTT_APP_ID=
CTT_PUBLIC_KEY=
CTT_SECRET_KEY=
CTT_SIMULATE=                    # 1 = X_SIMULATE (nothing stored at CTT): first tests with the real key
CTT_CARRIER_ID=                  # optional; empty = the rulebook in the CTT app chooses the service
CTT_OPTION_IDS=                  # optional, comma separated option ids from GET /carriers/
CTT_LABEL_TYPE=0                 # 0 = PDF, 1 = ZPL
CTT_BOX_WEIGHT_G=4000            # declared weight per Trilogia box (6 bottles = 8 kg)

# Portugal HR callers (docs/PT-CALLERS.md). Everything OFF by default: demo data, no Apollo, no dial.
PT_CALLERS_ENABLED=                 # exactly "true" to enable
PT_CALLERS_LEGAL_APPROVED=          # exactly "true" once the Portuguese lawyer's written approval exists
APOLLO_API_KEY=                     # restricted key (search, bulk_match, webhook_result/show), never a master key
APOLLO_ENRICH_DELIVERY=             # webhook (default) | poll
APOLLO_WEBHOOK_BASE_URL=            # https://... public base of this app
APOLLO_DAILY_CREDIT_CAP=            # default 300
APOLLO_MONTHLY_CREDIT_CAP=          # default 4000 (the Free plan has 75)
PT_CALLERS_DAILY_CALL_CAP=          # team calls per day; unset = no calls
PT_CALLERS_REP_DAILY_CALL_CAP=      # default 80
PT_CALLERS_MAX_ATTEMPTS_PER_LEAD=   # default 3
PT_CALLERS_CALLING_HOURS=           # e.g. mon-fri 09:30-18:00 (Lisbon); unset = no calls
PT_CALLERS_PILOT_ONLY=              # on unless exactly "false"
PT_CALLERS_PILOT_NUMBERS=           # +351 test numbers, comma-separated
PT_CALLERS_BLOCK_PEPPER=            # set once, never change
PT_TELNYX_API_KEY=                  # the project's OWN Telnyx account (not TELNYX_API_KEY)
PT_TELNYX_CONNECTION_ID=
PT_TELNYX_WEBRTC_CONNECTION_ID=
PT_TELNYX_FROM_NUMBER=              # +351...
PT_TELNYX_PUBLIC_KEY=
